<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GUI"
             x:Name="CardManagementPage" x:Class="GUI.CardDatabasePage"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" DataContext="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}">
  <UserControl.Resources>
    <CollectionViewSource x:Key="PrizeTaskView" Source="{Binding Database.LoadedPrizeTasks}"/>
    <CollectionViewSource x:Key="SecretTaskView" Source="{Binding Database.LoadedSecretTasks}"/>
    <CollectionViewSource x:Key="TaskView" Source="{Binding Database.LoadedTasks}"/>
    <CollectionViewSource x:Key="RestrictionView" Source="{Binding Database.LoadedRestrictions}"/>
    <CollectionViewSource x:Key="FinalTaskView" Source="{Binding Database.LoadedFinalTasks}"/>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="35"/>
      <RowDefinition Height="30"/>
      <RowDefinition/>
      <RowDefinition Height="33"/>
    </Grid.RowDefinitions>

    <DockPanel x:Name="MenuControlsDockPanel">
      <Button x:Name="BackButton" Content="Back" HorizontalAlignment="Left" Height="20" Margin="3,0,18,0" Width="60"/>
      <Label x:Name="SelectedDatabaseLabel" Content="Selected Database:" VerticalAlignment="Center"/>
      <Button x:Name="ImportButton" DockPanel.Dock="Right" Content="Import" Height="20" Margin="23,0,3,0" Width="60" Click="ImportButton_Click"/>
      <Button x:Name="DatabaseSelectButton" DockPanel.Dock="Right" Height="23" Width="23" HorizontalAlignment="Right" Margin="3,0,0,1" Click="DatabaseSelectButton_Click" BorderBrush="{x:Null}">
        <Button.Background>
          <ImageBrush ImageSource="folder-select-icon.png" Stretch="Uniform"/>
        </Button.Background>
      </Button>
      <TextBox x:Name="SelectedDatabasePath" VerticalAlignment="Center" DockPanel.Dock="Right" IsReadOnly="True" Background="LightGray"/>
    </DockPanel>

    <TextBox x:Name="SearchCriteriaEdit" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Row="1" Margin="3,3,3,2.2"
             local:TextBoxHelper.Placeholder="Search Criteria" TextChanged="SearchCriteriaEdit_TextChanged"/>

    <TabControl x:Name="TableTabControl" Margin="0" Grid.Row="2" Padding="0">
      <TabItem x:Name="PrizeTaskTab" Header="Prize Tasks">
        <DataGrid x:Name="PrizeTaskTable" AutoGenerateColumns="False" ItemsSource="{Binding Mode=OneWay, Source={StaticResource PrizeTaskView}}"
                  IsReadOnly="True" AlternatingRowBackground="LightBlue">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="PrizeTaskIdColumn" Binding="{Binding MetaData.ID}" Header="ID" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="PrizeTaskCreatedColumn" Binding="{Binding MetaData.Created}" Header="Created" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="PrizeTaskLastModifiedColumn" Binding="{Binding MetaData.LastModified}" Header="Last Modified" IsReadOnly="True"/>
            <DataGridTemplateColumn x:Name="PrizeTaskDescriptionColumn" Header="Description" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RawDescription}" TextWrapping="Wrap" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem x:Name="SecretTaskTab" Header="Secret Tasks" Margin="0">
        <DataGrid x:Name="SecretTaskTable" AutoGenerateColumns="False" ItemsSource="{Binding Mode=OneWay, Source={StaticResource SecretTaskView}}"
                  IsReadOnly="True" AlternatingRowBackground="LightBlue">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="SecretTaskIdColumn" Binding="{Binding MetaData.ID}" Header="ID"/>
            <DataGridTextColumn x:Name="SecretTaskCreatedColumn" Binding="{Binding MetaData.Created}" Header="Created"/>
            <DataGridTextColumn x:Name="SecretTaskLastModifiedColumn" Binding="{Binding MetaData.LastModified}" Header="Last Modified"/>
            <DataGridTemplateColumn x:Name="SecretTaskDescriptionColumn" Header="Description">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RawDescription}" TextWrapping="Wrap" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="SecretTaskScoreColumn" Header="Score">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RawScore}" TextWrapping="Wrap" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem x:Name="TaskTab" Header="Tasks" Margin="0">
        <DataGrid x:Name="TaskTable" AutoGenerateColumns="False" ItemsSource="{Binding Mode=OneWay, Source={StaticResource TaskView}}"
                  IsReadOnly="True" AlternatingRowBackground="LightBlue">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="TaskIdColumn" Binding="{Binding MetaData.ID}" Header="ID" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="TaskCreatedColumn" Binding="{Binding MetaData.Created}" Header="Created" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="TaskLastModifiedColumn" Binding="{Binding MetaData.LastModified}" Header="Last Modified" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTemplateColumn x:Name="TaskDescriptionColumn" Header="Description" CanUserReorder="False" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RawDescription}" TextWrapping="Wrap" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="TaskMaterialsColumn" Header="Materials" CanUserReorder="False" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RawMaterials}" TextWrapping="Wrap" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="TaskCriteraColumn"  Header="Critera" CanUserReorder="False" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RawCriteria}" TextWrapping="Wrap" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn x:Name="TaskIsTeamTaskColumn" Binding="{Binding RawIsTeamTask}" Header="Is a Team Task" CanUserReorder="False" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem x:Name="RestrictionTab" Header="Restrictions" Margin="0">
        <DataGrid x:Name="RestrictionTable" AutoGenerateColumns="False" ItemsSource="{Binding Mode=OneWay, Source={StaticResource RestrictionView}}"
                  IsReadOnly="True" AlternatingRowBackground="LightBlue">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="RestrictionIdColumn" Binding="{Binding MetaData.ID}" Header="ID" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="RestrictionCreatedColumn" Binding="{Binding MetaData.Created}" Header="Created" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="RestrictionLastModifiedColumn" Binding="{Binding MetaData.LastModified}" Header="Last Modified" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTemplateColumn x:Name="RestrictionDescriptionColumn" Header="Description" CanUserReorder="False" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RawDescription}" TextWrapping="Wrap" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem x:Name="FinalTaskTab" Header="Final Tasks" Margin="0">
        <DataGrid x:Name="FinalTaskTable" AutoGenerateColumns="False" ItemsSource="{Binding Mode=OneWay, Source={StaticResource FinalTaskView}}"
                  IsReadOnly="True" AlternatingRowBackground="LightBlue">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="FinalTaskIdColumn" Binding="{Binding MetaData.ID}" Header="ID" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="FinalTaskCreatedColumn" Binding="{Binding MetaData.Created}" Header="Created" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="FinalTaskLastModifiedColumn" Binding="{Binding MetaData.LastModified}" Header="Last Modified" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTemplateColumn x:Name="FinalTaskDescriptionColumn" Header="Description" CanUserReorder="False" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RawDescription}" TextWrapping="Wrap" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="FinalTaskMaterialsColumn" Header="Materials" CanUserReorder="False" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RawMaterials}" TextWrapping="Wrap" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Name="FinalTaskCriteraColumn" Header="Critera" CanUserReorder="False" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding RawCriteria}" TextWrapping="Wrap" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn x:Name="FinalTaskIsTeamTaskColumn" Binding="{Binding RawIsTeamTask}" Header="Is a Team Task" CanUserReorder="False" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>

    <DockPanel x:Name="BottomDock" Margin="0,5,0,6" Grid.Row="3" >
      <Label x:Name="StatusLabel" Content="" VerticalContentAlignment="Center" Padding="3,0,3,0" />
      <StackPanel x:Name="CardButtonStackPanel"  Orientation="Horizontal" ScrollViewer.VerticalScrollBarVisibility="Disabled" FlowDirection="RightToLeft">
        <Button x:Name="DeleteCardButton" Content="Delete" Width="60" Margin="3,0,3,0" Click="DeleteCardButton_Click"/>
        <Button x:Name="CopyCardButton" Content="Copy" Width="60" Margin="3,0,3,0" Click="CopyCardButton_Click"/>
        <Button x:Name="EditCardButton" Content="Edit" Width="60" Margin="3,0,3,0" Click="EditCardButton_Click"/>
        <Button x:Name="AddCardButton" Content="Add" Width="60" Margin="3,0,0,0" Click="AddCardButton_Click"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</UserControl>
