<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GUI"
             x:Name="CardManagementPage" x:Class="GUI.CardDatabasePage"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" DataContext="{Binding Mode=OneWay, RelativeSource={RelativeSource Self}}">
  <UserControl.Resources>
    <CollectionViewSource x:Key="PrizeTaskView" Source="{Binding Database.LoadedPrizeTasks}"/>
    <CollectionViewSource x:Key="SecretTaskView" Source="{Binding Database.LoadedSecretTasks}"/>
    <CollectionViewSource x:Key="TaskView" Source="{Binding Database.LoadedTasks}"/>
    <CollectionViewSource x:Key="RestrictionView" Source="{Binding Database.LoadedRestrictions}"/>
    <CollectionViewSource x:Key="FinalTaskView" Source="{Binding Database.LoadedFinalTasks}"/>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="35"/>
      <RowDefinition Height="30"/>
      <RowDefinition/>
      <RowDefinition Height="33"/>
    </Grid.RowDefinitions>

    <DockPanel x:Name="MenuControlsDockPanel">
      <Button x:Name="BackButton" Content="Back" HorizontalAlignment="Left" VerticalAlignment="Center" Height="20" Margin="3,0,0,0" Width="60"/>
      <Button x:Name="ImportButton" DockPanel.Dock="Right" Content="Import" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="20" Margin="0,0,3,7.2" Width="60"/>
    </DockPanel>
    <DockPanel x:Name="CardFilterDockPanel" Margin="0,0,0,5" Grid.Row="1" >
      <Button x:Name="SearchButton" Content="Search" Width="60" Height="20" Margin="3,2,3,1.2" DockPanel.Dock="Right"/>
      <TextBox x:Name="SearchCriteriaEdit" TextWrapping="Wrap" VerticalAlignment="Center"
            local:TextBoxHelper.Placeholder="Search Criteria" Margin="3,3,3,2.2"/>
    </DockPanel>
    <TabControl x:Name="TableTabControl" Margin="0" Grid.Row="2">
      <TabItem x:Name="PrizeTaskTab" Header="Prize Tasks">
        <DataGrid x:Name="PrizeTaskTable" AutoGenerateColumns="False" ItemsSource="{Binding Mode=OneWay, Source={StaticResource PrizeTaskView}}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="PrizeTaskIdColumn" Binding="{Binding MetaData.ID}" Header="ID" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="PrizeTaskCreatedColumn" Binding="{Binding MetaData.Created}" Header="Created" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="PrizeTaskLastModifiedColumn" Binding="{Binding MetaData.LastModified}" Header="Last Modified" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="PrizeTaskDescriptionColumn" Binding="{Binding RawDescription}" Header="Description" CanUserReorder="False" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem x:Name="SecretTaskTab" Header="Secret Tasks" Margin="0">
        <DataGrid x:Name="SecretTaskTable" AutoGenerateColumns="False" ItemsSource="{Binding Mode=OneWay, Source={StaticResource SecretTaskView}}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="SecretTaskIdColumn" Binding="{Binding MetaData.ID}" Header="ID"/>
            <DataGridTextColumn x:Name="SecretTaskCreatedColumn" Binding="{Binding MetaData.Created}" Header="Created"/>
            <DataGridTextColumn x:Name="SecretTaskLastModifiedColumn" Binding="{Binding MetaData.LastModified}" Header="Last Modified"/>
            <DataGridTextColumn x:Name="SecretTaskDescriptionColumn" Binding="{Binding RawDescription}" Header="Description"/>
            <DataGridTextColumn x:Name="SecretTaskScoreColumn" Binding="{Binding RawScore}" Header="Score"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem x:Name="TaskTab" Header="Tasks" Margin="0">
        <DataGrid x:Name="TaskTable" AutoGenerateColumns="False" ItemsSource="{Binding Mode=OneWay, Source={StaticResource TaskView}}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="TaskIdColumn" Binding="{Binding MetaData.ID}" Header="ID" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="TaskCreatedColumn" Binding="{Binding MetaData.Created}" Header="Created" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="TaskLastModifiedColumn" Binding="{Binding MetaData.LastModified}" Header="Last Modified" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="TaskDescriptionColumn" Binding="{Binding RawDescription}" Header="Description" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="TaskMaterialsColumn" Binding="{Binding RawMaterials}" Header="Materials" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="TaskCriteraColumn" Binding="{Binding RawCriteria}" Header="Critera" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="TaskIsTeamTaskColumn" Binding="{Binding RawIsTeamTask}" Header="Is a Team Task" CanUserReorder="False" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem x:Name="RestrictionTab" Header="Restrictions" Margin="0">
        <DataGrid x:Name="RestrictionTable" AutoGenerateColumns="False" ItemsSource="{Binding Mode=OneWay, Source={StaticResource RestrictionView}}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="RestrictionIdColumn" Binding="{Binding MetaData.ID}" Header="ID" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="RestrictionCreatedColumn" Binding="{Binding MetaData.Created}" Header="Created" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="RestrictionLastModifiedColumn" Binding="{Binding MetaData.LastModified}" Header="Last Modified" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="RestrictionDescriptionColumn" Binding="{Binding RawDescription}" Header="Description" CanUserReorder="False" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem x:Name="FinalTaskTab" Header="Final Tasks" Margin="0">
        <DataGrid x:Name="FinalTaskTable" AutoGenerateColumns="False" ItemsSource="{Binding Mode=OneWay, Source={StaticResource FinalTaskView}}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="FinalTaskIdColumn" Binding="{Binding MetaData.ID}" Header="ID" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="FinalTaskCreatedColumn" Binding="{Binding MetaData.Created}" Header="Created" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="FinalTaskLastModifiedColumn" Binding="{Binding MetaData.LastModified}" Header="Last Modified" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="FinalTaskDescriptionColumn" Binding="{Binding RawDescription}" Header="Description" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="FinalTaskMaterialsColumn" Binding="{Binding RawMaterials}" Header="Materials" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="FinalTaskCriteraColumn" Binding="{Binding RawCriteria}" Header="Critera" CanUserReorder="False" IsReadOnly="True"/>
            <DataGridTextColumn x:Name="FinalTaskIsTeamTaskColumn" Binding="{Binding RawIsTeamTask}" Header="Is a Team Task" CanUserReorder="False" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
    <StackPanel x:Name="CardButtonStackPanel" Margin="0,5,0,6" Grid.Row="3" Orientation="Horizontal" ScrollViewer.VerticalScrollBarVisibility="Disabled" FlowDirection="RightToLeft">
      <Button x:Name="DeleteCardButton" Content="Delete" Width="60" Margin="3,0" Click="DeleteCardButton_Click"/>
      <Button x:Name="CopyCardButton" Content="Copy" Width="60" Margin="3,0,3,0" Click="CopyCardButton_Click"/>
      <Button x:Name="EditCardButton" Content="Edit" Width="60" Margin="3,0,3,0" Click="EditCardButton_Click"/>
      <Button x:Name="AddCardButton" Content="Add" Width="60" Margin="3,0,3,0" Click="AddCardButton_Click"/>
    </StackPanel>
  </Grid>
</UserControl>
