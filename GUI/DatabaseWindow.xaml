<Window x:Class="GUI.DatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI"
        mc:Ignorable="d"
        Title="DatabaseWindow" Height="210.071" Width="590.995">
  <Grid>
    <TextBox x:Name="DatabasePathEdit" HorizontalAlignment="Left" Height="23" Margin="31,30,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="323" IsReadOnly="True"/>
    <Grid Margin="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="118*"/>
        <ColumnDefinition Width="110*"/>
        <ColumnDefinition Width="125*"/>
        <ColumnDefinition Width="83*"/>
        <ColumnDefinition Width="149*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="78*"/>
        <RowDefinition Height="103*"/>
      </Grid.RowDefinitions>
      <Button x:Name="ImportButton" Content="Import CSV Database" HorizontalAlignment="Left" Margin="0.4,41.4,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Grid.Column="1" Grid.Row="1"/>
      <Button x:Name="BackButton" Content="Back" HorizontalAlignment="Left" Margin="8.2,41.4,0,0" VerticalAlignment="Top" Width="75" IsCancel="True" Grid.Column="3" Grid.Row="1"/>
      <TextBox x:Name="DatabasePathEdit_Copy" HorizontalAlignment="Left" Height="23" Margin="30,29,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="442" IsReadOnly="True" Grid.ColumnSpan="5"/>
      <Button x:Name="FolderSelectButton" Content="" HorizontalAlignment="Left" Margin="58,32,0,0" VerticalAlignment="Top" Width="20" Height="20" RenderTransformOrigin="4.766,1.465" Grid.Column="4">
        <Button.Background>
          <ImageBrush ImageSource="folder-select-icon.png" Stretch="Uniform"/>
        </Button.Background>
      </Button>
    </Grid>

  </Grid>
</Window>
